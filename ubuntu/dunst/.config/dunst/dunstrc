[global]
    # Placement & look
    origin = top-right
    offset = 7x47
    padding = 12
    horizontal_padding = 16
    frame_width = 2
    separator_height = 2
    corner_radius = 10

    # Pink accents
    frame_color = "#FF6AA9"          # main pink frame
    separator_color = "#FF8FBF"      # lighter pink separator

    # Colors & fonts
    font = JetBrains Mono 10
    icon_theme = hicolor
    icon_position = left
    max_icon_size = 48
    format = "<b>%s</b>\n%b"
    markup = full

    # Behavior
    history_length = 20
    sticky_history = yes
    sort = yes
    show_indicators = yes
    follow = keyboard
    fullscreen = pushback
    transparency = 0

    # Mouse
    mouse_left_click = do_action, close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    # Dark plum bg, soft text, soft pink frame
    background = "#140A11"
    foreground = "#FFD9E9"
    frame_color = "#FF8FBF"
    timeout = 4

[urgency_normal]
    # Main dark bg, bright text, vivid pink frame
    background = "#1A0F16"
    foreground = "#FFE7F3"
    frame_color = "#FF6AA9"
    timeout = 7

[urgency_critical]
    # Deeper rose bg, near-white text, hot pink frame (no auto-dismiss)
    background = "#3A0F26"
    foreground = "#FFF3F8"
    frame_color = "#FF2E74"
    timeout = 0
