  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "languages": {
    "C++": {
      "show_edit_predictions": true
    }
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null
    },
    "enabled_in_text_threads": false
  },
  "project_panel": {
    "dock": "left"
  },
  "show_edit_predictions": false,
  "chat_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "agent": {
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5"
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5"
    },
  },
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "buffer_font_family": "Consolas ligaturized v3",
  "theme": {
    "mode": "system",
    "light": "Tokyo Night Storm",
    "dark": "Tokyo Night Storm"
  },
  "autosave": "on_focus_change",
  "base_keymap": "VSCode",

  "active_pane_modifiers": {
    "magnification": 1.0,
    "border_size": 2.0,
    "inactive_opacity": 0.5
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
