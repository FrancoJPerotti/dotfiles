  "diff_view_style": "split",
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "languages": {
    "C++": {
      "show_edit_predictions": true
    }
  },
  "edit_predictions": {
    "disabled_globs": [
      "..."
    ],
    "provider": "copilot",
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null
    },
    "enabled_in_text_threads": false
  },
  "project_panel": {
    "dock": "left"
  },
  "chat_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "threads_sidebar": {
      "position": "right"
    },
    "default_profile": "write",
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5"
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna"
    },
  },
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 18,
  "buffer_font_family": "Consolas ligaturized v3",
  "theme": {
    "mode": "system",
    "light": "Tokyo Night Storm",
    "dark": "Tokyo Night Storm"
  },
  "theme_overrides": {
    "Tokyo Night Storm": {
      "vim.normal.background": "#7aa2f7",
      "vim.normal.foreground": "#1a1b26",
      "vim.insert.background": "#9ece6a",
      "vim.insert.foreground": "#1a1b26",
      "vim.visual.background": "#bb9af7",
      "vim.visual.foreground": "#1a1b26",
      "vim.visual_line.background": "#bb9af7",
      "vim.visual_line.foreground": "#1a1b26",
      "vim.visual_block.background": "#bb9af7",
      "vim.visual_block.foreground": "#1a1b26",
      "vim.replace.background": "#f7768e",
      "vim.replace.foreground": "#1a1b26"
    }
  },
  "autosave": "on_focus_change",
  "base_keymap": "VSCode",

  "active_pane_modifiers": {
    "magnification": 1.0,
    "border_size": 2.0,
    "inactive_opacity": 0.5
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
