{ 
  // Window settings
  "window.customMenuBarAltFocus": false,        // Disable alt focus
  "window.enableMenuBarMnemonics": false,       // Disable menu bar mnemonics
  "window.menuBarVisibility": "visible", // Set color theme
  "workbench.activityBar.location": "hidden",   // Hide activity bar
  "editor.minimap.enabled": false, // Enable command center
  "window.titleBarStyle": "custom",             // Set title bar style
  "editor.lightbulb.enabled": "off",            // Disable lightbulb
  "accessibility.dimUnfocused.enabled": true,  // Enable dim unfocused
  "accessibility.dimUnfocused.opacity": 0.65,   // Set dim unfocused opacity

  // Vim extension settings
  "vim.statusBarColorControl": true,
  "vim.statusBarColors.normal": ["#141F34", "#C4C4C4"],
  "vim.statusBarColors.insert": ["#BF616A", "#000000"],
  "vim.statusBarColors.visual": ["#B0E57C", "#000000"],
  "vim.statusBarColors.visualline": ["#B48EAD", "#000000"],
  "vim.statusBarColors.visualblock": ["#D8BFD8", "#000000"],
  "vim.statusBarColors.replace": "#D08770",
  "vim.statusBarColors.commandlineinprogress": ["#007ACC", "#000000"],
  "vim.statusBarColors.searchinprogressmode": ["#007ACC", "#000000"],
  "vim.statusBarColors.easymotionmode": ["#007ACC", "#000000"],
  "vim.statusBarColors.easymotioninputmode": ["#007ACC", "#000000"],
  "vim.statusBarColors.surroundinputmode": ["#007ACC", "#000000"],
  "vim.easymotion": true,               // Enable easymotion
  "vim.easymotionKeys": "arstneiodhlp", // Set the keys to use for easymotion
  "vim.incsearch": true,                // Enable incremental search
  "vim.useSystemClipboard": true,       // Use the system clipboard
  "vim.useCtrlKeys": true,              // Use ctrl keys
  "vim.hlsearch": true,                 // Highlight search
  "vim.surround": true,

  // Vim keybindings
  "vim.normalModeKeyBindings":[ 
    {
      // Easymotion keybinding (start of word)
      "before": ["<leader>", "s"],
      "after": ["<leader>", "<leader>", "s"]
    },
    {
      // Command palette keybinding
      "before": [":"],
      "commands": ["workbench.action.showCommands"]
    },
    {
      // Open floating file selector (Quick Open)
      "before": ["<leader>", "<leader>"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      // Select Opened buffers
      "before": ["<leader>", "t"],
      "commands": ["workbench.action.showAllEditors"]
    },
    {
      // Close active editor with Ctrl+Q Ctrl+Q
      "before": ["<C-q>", "<C-q>"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      // Close active editor with Ctrl+Q Ctrl+Q
      "before": ["<C-q>", "<C-q>"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      // Close all editors with Ctrl+Q Ctrl+A
      "before": ["<C-q>", "<C-a>"],
      "commands": ["workbench.action.closeAllEditors"]
    },
    {
      // Save current file with Ctrl+W Ctrl+W
      "before": ["<C-w>", "<C-w>"],
      "commands": ["workbench.action.files.save"]
    }

  ],

  "vim.visualModeKeyBindings": [
    {
      // Inline chat keybinding
      "before": ["<leader>", "a", "e"],
      "commands": ["inlineChat.start"],
      "silent": true
    }
  ],

"vim.leader": "<space>", // Set leader key
"vim.handleKeys": {
  "<C-a>": false, // Disable ctrl-a
  "<C-f>": false, // Disable ctrl-f
  "<space>e": false,
  "<space>g": false
},

// Editor settings
"editor.lineNumbers": "relative",                   // Set line numbers to relative
"editor.fontFamily": "CaskaydiaCove Nerd Font Mono",     // Set font family
"editor.fontLigatures": true,                       // Enable font ligatures
"security.workspace.trust.untrustedFiles": "open",  // Open untrusted files
"files.autoSave": "afterDelay",                     // Autosave files after delay

// Copilot settings
"github.copilot.enable": {
  "*": true,
  "plaintext": true,
  "markdown": false,
  "scminput": true
},
"vscode-home-assistant.ignoreCertificates": true,
"workbench.colorCustomizations": {
  "statusBar.background": "#141F34",
  "statusBar.noFolderBackground": "#141F34",
  "statusBar.debuggingBackground": "#141F34",
  "statusBar.foreground": "#C4C4C4",
  "statusBar.debuggingForeground": "#C4C4C4"
},
"editor.overviewRulerBorder": false,
"git.openRepositoryInParentFolders": "always",
"[yaml]": {

  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.autoIndent": "keep",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.defaultColorDecorators": "never",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  }
},
"github.copilot.selectedCompletionModel": "gpt-4o-copilot",
"cSpell.language": "en,es-ES",
"[markdown]": {

  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.wordWrap": "on",
  "editor.quickSuggestions": {
    "comments": "off",
    "strings": "off",
    "other": "off"
    },
    "cSpell.fixSpellingWithRenameProvider": true,
    "cSpell.advanced.feature.useReferenceProviderWithRename": true,
    "cSpell.advanced.feature.useReferenceProviderRemove": "/^#+\\s/",
    "editor.defaultFormatter": "tehnix.vscode-tidymarkdown"
  },
  "cSpell.userWords": [
    "AWGN",
    "colocándolos",
    "conversor",
    "demodulación",
    "demodulados",
    "equiespaciadas",
    "IDFT",
    "IFFT",
    "multiportadora",
    "OFDM",
    "ortogonalidad",
    "subportadora",
    "subportadoras"
  ],
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.colorTheme": "GitHub Dark Dimmed",
  "window.commandCenter": false,
  "explorer.confirmDelete": false,
}
