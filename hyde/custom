// Colemak-DH Wide ISO Custom

default partial alphanumeric_keys modifier_keys
xkb_symbols "cdhwic" {

    name[Group1]= "Colemak-DH Wide ISO Custom";
    key.type[Group1] = "EIGHT_LEVEL";

    key <TLDE> { [    semicolon,        colon,      dead_tilde,       asciitilde ] };
    key <AE01> { [            1,       exclam,      exclamdown,      onesuperior ] };
    key <AE02> { [            2,           at,       masculine,      twosuperior ] };
    key <AE03> { [            3,   numbersign,     ordfeminine,    threesuperior ] };
    key <AE04> { [            4,       dollar,            cent,         sterling ] };
    key <AE05> { [            5,      percent,        EuroSign,              yen ] };
    key <AE06> { [            6,  asciicircum,         hstroke,          Hstroke ] };
    key <AE07> { [            7,    ampersand,             eth,              ETH ] };
    key <AE08> { [            8,     asterisk,           thorn,            THORN ] };
    key <AE09> { [            9,    parenleft,  leftsinglequotemark,  leftdoublequotemark ] };
    key <AE10> { [            0,   parenright, rightsinglequotemark,  rightdoublequotemark ] };
    key <AE11> { [        minus,   underscore,          endash,           emdash ] };
    key <AE12> { [        equal,         plus,        multiply,         division ] };

    key <AD01> { [            q,            Q,        quotedbl,       Adiaeresis ] };
    key <AD02> { [            w,            W,      apostrophe,            Aring ] };
    key <AD03> { [            f,            F,          dollar,           Atilde ] };
    key <AD04> { [            p,            P,      asciitilde,           Oslash ] };
    key <AD05> { [            b,            B                                    ] };
    key <AD06> { [        slash,    backslash                                    ] };
    key <AD07> { [         plus,    plusminus,        asterisk,        0x1002039 ] };
    key <AD08> { [            j,            J,     asciicircum,          Dstroke ] };
    key <AD09> { [            l,            L,       parenleft,       parenright ] };
    key <AD10> { [            u,            U,       braceleft,       braceright ] };
    key <AD11> { [            y,            Y,            less,          greater ] };
    key <AD12> { [       ntilde,       Ntilde,     bracketleft,     bracketright ] };

    key <AC01> { [            a,            A,           colon,           Aacute ] };
    key <AC02> { [            r,            R,       semicolon,       asciitilde ] };
    key <AC03> { [            s,            S,           comma,        0x1001e9e ] };
    key <AC04> { [            t,            T,          period, dead_doubleacute ] };
    key <AC05> { [            g,            G,              at,       asciitilde ] };
    key <AC06> { [    semicolon,        colon                                    ] };
    key <AC07> { [        minus,       endash,      underscore,       asciitilde ] };
    key <AC08> { [            m,            M,          exclam,       exclamdown ] };
    key <AC09> { [            n,            N,      underscore,           Ntilde ] };
    key <AC10> { [            e,            E,           equal,           Eacute ] };
    key <AC11> { [            i,            I,       ampersand,           Iacute ] };
    key <AC12> { [            o,            O,             bar,           Oacute ] };

    key <LSGT> { [            z,            Z,           slash,               AE ] };
    key <AB01> { [            x,            X,       backslash,       asciitilde ] };
    key <AB02> { [            c,            C,           minus,         Ccedilla ] };
    key <AB03> { [            d,            D,      numbersign,               OE ] };
    key <AB04> { [            v,            V,         percent,       asciitilde ] };
    key <AB05> { [        comma,         less                                    ] };
    key <AB06> { [       period,      greater                                    ] };    
    key <AB07> { [     asterisk,     asterisk,      braceright,       asciitilde ] };
    key <AB08> { [            k,            K,        asterisk,       asciitilde ] };
    key <AB09> { [            h,            H,            plus,       asciitilde ] };
    key <AB10> { [     question, questiondown,           minus,       asciitilde ] };

    key <CAPS> { [Caps_Lock]};
    key <SPCE> { [space, space, space, space ]};
    key <LWIN> { [Super_L] };
    
    key <LALT> {[  ISO_Level3_Shift  ], type[group1]="ONE_LEVEL" };
    key <RALT> {[  ISO_Level5_Shift  ], type[group1]="ONE_LEVEL" };
};

