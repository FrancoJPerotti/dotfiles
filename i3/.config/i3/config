### Variables ###
# Super/Meta/Windows key
set $mod Mod4

### Window Actions ###

# Drag floating windows
floating_modifier $mod

# Kill focused window
bindsym F12 kill

# Toggle floating
bindsym $mod+Shift+f floating toggle

# Toggle group
bindsym $mod+Shift+g layout toggle tabbed split

# Change focus
bindsym $mod+n focus left
bindsym $mod+e focus down
bindsym $mod+i focus up
bindsym $mod+o focus right

# Move focused window
bindsym $mod+Left move left
bindsym $mod+Down move down
bindsym $mod+Up move up
bindsym $mod+Right move right

# within “groups” (tabbed/stacked containers), cycle members
# bindsym $mod+u focus prev
# bindsym $mod+y focus next

# 
bindsym $mod+l workspace prev
# bindsym $mod+Mod1+ntilde workspace next
bindsym $mod+End  move container to workspace next
bindsym $mod+Home move container to workspace prev

# Resize focused window
bindsym $mod+Mod1+n resize shrink width 10px 
bindsym $mod+Mod1+o resize grow width 10px
bindsym $mod+Mod1+i resize shrink height 10px
bindsym $mod+Mod1+e resize grow height 10px

# start a terminal
bindsym $mod+space exec i3-sensible-terminal

# Toggle app launcher
bindsym --release $mod+Return exec --no-startup-id "rofi -no-lazy-grab -show drun -kb-cancel \\"Escape,Super+Return\\""

# Toggle file browser
bindsym --release $mod+Shift+Return exec --no-startup-id "rofi -no-lazy-grab -modi drun,run,filebrowser -show filebrowser -kb-cancel \\"Escape,Super+Shift+Return\\""


# split in horizontal orientation
# bindsym $mod+h split h

# split in vertical orientation
# bindsym $mod+v split v

# change focus between tiling / floating windows
# bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# reload the configuration file
bindsym $mod+Shift+r reload

# Take screenshot
bindsym $mod+p exec --no-startup-id maim --select -o | xclip -selection clipboard -t image/png

# Toggle clipboard (greenclip)
bindsym --release $mod+c exec --no-startup-id "rofi -no-lazy-grab -modi 'clipboard:greenclip print' -show clipboard -run-command '{cmd}' -kb-cancel \\"Escape,Super+c\\""

# Power Menu
bindsym $mod+Shift+equal exec --no-startup-id ~/.local/bin/rofi_power.sh

# Update System 
bindsym $mod+Shift+u exec --no-startup-id "i3-sensible-terminal -e bash -lc '~/.local/bin/update.sh -y; echo; read -n1 -rsp \\"Press any key to close...\\"'"

# ── 🔊 Audio control (PipeWire / wpctl) ─────────────────────────────────────────
bindsym XF86AudioMute         exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioLowerVolume  exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioRaiseVolume  exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+

# ── 🎵 Media control (playerctl) ───────────────────────────────────────────────
bindsym XF86AudioPlay         exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext         exec --no-startup-id playerctl next
bindsym XF86AudioPrev         exec --no-startup-id playerctl previous

# ── 🌞 Brightness (brightnessctl) ──────────────────────────────────────────────
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

# --- Workspaces ---
set $ws_web "web"
set $ws_editor "editor"
set $ws_term "term"
set $ws_exp "exp"
set $ws_spotify "spotify"
set $ws_discord "discord"
set $ws_whatsapp "whatsapp"
set $ws_ticktick "ticktick"
set $ws_chatgpt "chatgpt"
set $ws_github "github"
set $ws_zathura "zathura"
set $ws_mail "mail"
set $ws_meet "meet"

# Assign applications to specific workspaces
assign [instance="^vivaldi-(.+)$"] $ws_web
assign [instance="^nvim$"] $ws_editor
assign [instance="^term$"] $ws_term
assign [instance="^yazi$"] $ws_exp
assign [instance="^spotify.com$"] $ws_spotify
assign [instance="^discord.com__app$"] $ws_discord
assign [instance="^web.whatsapp.com$"] $ws_whatsapp
assign [instance="^ticktick.com$"] $ws_ticktick
assign [instance="^chatgpt.com$"] $ws_chatgpt
assign [instance="^github.com$"] $ws_github
assign [class="^Zathura$"] $ws_zathura
assign [instance="^mail\.google\.com__mail_u_(\d+)$"] $ws_mail
assign [instance="^outlook\.live\.com__mail_(\d+)$"] $ws_mail
assign [instance="^meet\.google\.com__(.+)$"] $ws_meet

# Define script path variable
set $script_path ~/.local/bin

# Keybindings to toggle or focus workspaces
bindsym $mod+h workspace $ws_web
bindsym $mod+Shift+slash workspace $ws_editor; layout tabbed
bindsym $mod+dead_acute workspace $ws_term
bindsym $mod+slash workspace $ws_exp
bindsym $mod+s exec --no-startup-id $script_path/toggle_workspace.sh $ws_spotify
bindsym $mod+d exec --no-startup-id $script_path/toggle_workspace.sh $ws_discord
bindsym $mod+w exec --no-startup-id $script_path/toggle_workspace.sh $ws_whatsapp
bindsym $mod+t exec --no-startup-id $script_path/toggle_workspace.sh $ws_ticktick
bindsym $mod+Tab exec --no-startup-id $script_path/toggle_workspace.sh --tabbed "$ws_chatgpt"
bindsym $mod+g exec --no-startup-id $script_path/toggle_workspace.sh --tabbed "$ws_github"
bindsym $mod+f   exec --no-startup-id $script_path/toggle_workspace.sh --tabbed "$ws_zathura"
bindsym $mod+m   exec --no-startup-id $script_path/toggle_workspace.sh --tabbed "$ws_mail"
bindsym $mod+minus   exec --no-startup-id $script_path/toggle_workspace.sh --tabbed "$ws_meet"

# Wallpaper Picker
bindsym $mod+Shift+w exec --no-startup-id $script_path/wallpaper_picker.sh

# Status Bar
bar {
        mode invisible
}

# Autostart script
exec --no-startup-id $script_path/autostart.sh
