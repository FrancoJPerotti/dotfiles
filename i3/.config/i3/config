### Variables ###

# Super/Meta/Windows key
set $mod Mod4

# Default terminal emulator
set $terminal ~/.local/kitty.app/bin/kitty

# Define script path variable
set $script_path ~/.local/bin

### Window Actions ###

# Drag floating windows
floating_modifier $mod

# Kill focused window
bindsym F12 kill

# Toggle floating
bindsym $mod+Shift+f floating toggle

# Toggle group
bindsym $mod+Shift+g layout toggle tabbed split

# Change focus
bindsym $mod+n focus left
bindsym $mod+e focus down
bindsym $mod+i focus up
bindsym $mod+o focus right

# Move focused window
bindsym $mod+Left   move left
bindsym $mod+Down   move down
bindsym $mod+Up     move up
bindsym $mod+Right  move right

# within “groups” (tabbed/stacked containers), cycle members
bindsym $mod+u focus prev
bindsym $mod+y focus next

bindsym $mod+l workspace prev
# bindsym $mod+Mod1+ntilde workspace next

bindsym $mod+End  move container to workspace next
bindsym $mod+Home move container to workspace prev

# Smart Directional Resize
bindsym $mod+Mod1+n     exec --no-startup-id $script_path/resize_improved.sh left  1
bindsym $mod+Control+n  exec --no-startup-id $script_path/resize_improved.sh left  1
bindsym $mod+Mod1+o     exec --no-startup-id $script_path/resize_improved.sh right 1
bindsym $mod+Control+o  exec --no-startup-id $script_path/resize_improved.sh right 1
bindsym $mod+Mod1+i     exec --no-startup-id $script_path/resize_improved.sh up    1
bindsym $mod+Control+i  exec --no-startup-id $script_path/resize_improved.sh up    1
bindsym $mod+Mod1+e     exec --no-startup-id $script_path/resize_improved.sh down  1
bindsym $mod+Control+e  exec --no-startup-id $script_path/resize_improved.sh down  1

# start a terminal
bindsym $mod+space      exec --no-startup-id $terminal

# Toggle app launcher
bindsym --release $mod+Return exec --no-startup-id "rofi -no-lazy-grab -show drun -kb-cancel \\"Escape,Super+Return\\""

# Toggle Window browser
bindsym --release $mod+Caps_Lock exec --no-startup-id "rofi -no-lazy-grab -modi drun,run,window -show window -kb-cancel \\"Escape,Super+Caps_Lock\\""

# focus the parent container
bindsym $mod+a focus parent

# reload the configuration file
bindsym $mod+Shift+r reload

# Take screenshot
bindsym $mod+p exec --no-startup-id flameshot gui -c -p ~/Pictures/Screenshots

# Power Menu
bindsym $mod+Shift+equal exec --no-startup-id ~/.local/bin/rofi_power.sh
bindsym $mod+plus exec --no-startup-id ~/.local/bin/rofi_power.sh

# Update System 
bindsym $mod+Shift+u exec --no-startup-id "$terminal -e bash -lc '~/.local/bin/update.sh -y --no-firmware; echo; read -n1 -rsp \\"Press any key to close...\\"'"

# ── 🔊 Audio control (PipeWire / wpctl) ─────────────────────────────────────────
bindsym XF86AudioMute         exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioLowerVolume  exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioRaiseVolume  exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+

# ── 🎵 Media control (playerctl) ───────────────────────────────────────────────
bindsym XF86AudioPlay         exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause        exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext         exec --no-startup-id playerctl next
bindsym XF86AudioPrev         exec --no-startup-id playerctl previous

# ── 🌞 Brightness (brightnessctl) ──────────────────────────────────────────────
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

# --- Workspaces ---
set $ws_web         "web"
set $ws_editor      "editor"
set $ws_term        "term"
set $ws_explorer    "explorer"
set $ws_spotify     "spotify"
set $ws_slack       "slack"
set $ws_whatsapp    "whatsapp"
set $ws_ticktick    "ticktick"
set $ws_chatgpt     "chatgpt"
set $ws_git         "git"
set $ws_zathura     "zathura"
set $ws_mail        "mail"
set $ws_meet        "meet"
set $ws_work        "work"
set $ws_youtube     "youtube"
set $ws_obsidian    "obsidian"

set $hdmi_monitor        HDMI-1
set $displayport_monitor DP-1
set $laptop_monitor      eDP-1

workspace $ws_web       output $hdmi_monitor $displayport_monitor $laptop_monitor
workspace $ws_editor    output $hdmi_monitor $displayport_monitor $laptop_monitor
workspace $ws_term      output $hdmi_monitor $displayport_monitor $laptop_monitor
workspace $ws_explorer  output $hdmi_monitor $displayport_monitor $laptop_monitor
workspace $ws_obsidian  output $laptop_monitor
workspace $ws_youtube   output $laptop_monitor

for_window [instance="^vivaldi-(.+)$"] \
    move to workspace $ws_web, \
    workspace $ws_web
for_window [instance="^nvim$"] \
    move to workspace $ws_editor, \
    workspace $ws_editor \
    focus parent, layout tabbed
for_window [instance="^nvim-workflow$"] \
    move to workspace $ws_editor, \
    workspace $ws_editor \
    focus parent, layout tabbed
for_window [instance="^code$"] \
    move to workspace $ws_editor, \
    workspace $ws_editor \
    focus parent, layout tabbed
for_window [instance="^term$"] \
    move to workspace $ws_term, \
    workspace $ws_term
for_window [instance="^yazi$"] \
    move to workspace $ws_explorer, \
    workspace $ws_explorer
for_window [instance="^spotify\.com(.*)$"] \
    move to workspace $ws_spotify, \
    workspace $ws_spotify
for_window [instance="^web\.whatsapp\.com$"] \
    move to workspace $ws_whatsapp, \
    workspace $ws_whatsapp
for_window [instance="^ticktick\.com$"] \
    move to workspace $ws_ticktick, \
    workspace $ws_ticktick
for_window [instance="^chatgpt\.com$"] \
    move to workspace $ws_chatgpt, \
    workspace $ws_chatgpt, \
    focus parent, layout tabbed
for_window [instance="^github\.com(.*)$"] \
    move to workspace $ws_git, \
    workspace $ws_git, \
    focus parent, layout tabbed
for_window [instance="^gitlab\.com(.*)$"] \
    move to workspace $ws_git, \
    workspace $ws_git, \
    focus parent, layout tabbed
for_window [class="^Zathura$"] \
    move to workspace $ws_zathura, \
    workspace $ws_zathura, \
    focus parent, layout tabbed
for_window [instance="^mail\.google\.com__mail_u_(\d+)$"] \
    move to workspace $ws_mail, \
    workspace $ws_mail, \
    focus parent, layout tabbed
for_window [instance="^outlook\.live\.com__mail_(\d+)$"] \
    move to workspace $ws_mail, \
    workspace $ws_mail, \
    focus parent, layout tabbed
for_window [instance="^meet\.google\.com__(.+)$"] \
    move to workspace $ws_meet, \
    workspace $ws_meet, \
    focus parent, layout tabbed
for_window [instance=".*\.atlassian\.net.*jira.*"] \
    move to workspace $ws_work, \
    workspace $ws_work, \
    focus parent, layout tabbed
for_window [instance=".*\.atlassian\.net.*wiki.*"] \
    move to workspace $ws_work, \
    workspace $ws_work, \
    focus parent, layout tabbed
for_window [instance="^trello\.com(.*)$"] \
    move to workspace $ws_work, \
    workspace $ws_work, \
    focus parent, layout tabbed
for_window [instance="^app\.slack\.com.*$"] \
    move to workspace $ws_slack, \
    workspace $ws_slack, \
    focus parent, layout tabbed
for_window [instance="^youtube\.com(.*)$"] \
    move to workspace $ws_youtube, \
    workspace $ws_youtube, \
    focus parent, layout tabbed
for_window [instance="^obsidian$"] \
    move to workspace $ws_obsidian, \
    workspace $ws_obsidian, \
    focus parent, layout tabbed


