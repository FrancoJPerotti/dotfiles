[Desktop Entry]
Type=Application
Name=Wallpaper Picker
Comment=Select and apply wallpapers via rofi
Exec=/bin/sh -c "$HOME/.local/bin/wallpaper_picker.sh"
Icon=preferences-desktop-wallpaper
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=rofi;wallpaper;background;desktop;
NoDisplay=false
StartupNotify=false
